# ==============================================================
# tablet-backend 환경 변수 설정 파일
# 이 파일을 복사하여 .env 파일을 생성한 후 실제 값을 입력하세요.
# cp .env.example .env
# ==============================================================

# Azure Document Intelligence
AZURE_DI_ENDPOINT=https://<your-instance>.cognitiveservices.azure.com/
AZURE_DI_KEY=<your-document-intelligence-api-key>
AZURE_DI_MODEL_ID=prebuilt-layout
AZURE_DI_API_VERSION=2024-11-30
AZURE_DI_MAX_POLL_ATTEMPTS=30
AZURE_DI_POLL_INTERVAL_MS=2000

# Azure OpenAI Service
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_KEY=<your-openai-api-key>
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_MAX_TOKENS=4096
AZURE_OPENAI_TEMPERATURE=0.3

# Server
SERVER_PORT=8080

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tablet_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
